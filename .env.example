# Development environment — copy to .env and edit as needed
DATABASE_URL=postgresql+psycopg://smartdialer:smartdialer_dev@localhost:5432/smartdialer
DATABASE_URL_ASYNC=postgresql+asyncpg://smartdialer:smartdialer_dev@localhost:5432/smartdialer
TEST_DATABASE_URL=postgresql+psycopg://smartdialer_test:smartdialer_test@localhost:5433/smartdialer_test
TEST_DATABASE_URL_ASYNC=postgresql+asyncpg://smartdialer_test:smartdialer_test@localhost:5433/smartdialer_test

# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key-change-in-prod

# Dialer defaults
DEFAULT_DIALING_MODE=progressive
MAX_CONCURRENT_CALLS_PER_CAMPAIGN=50
MAX_ATTEMPTS_PER_BORROWER=3
BORROWER_RETRY_COOLDOWN_SECONDS=3600
AGENT_HEARTBEAT_TIMEOUT_SECONDS=30
WORKER_LEASE_SECONDS=60

# Safety controller
SAFETY_MAX_DIAL_RATIO=3.0
SAFETY_STRICT_MODE=true

# Predictive pacing
PACER_UTILIZATION_TARGET=0.85
PACER_SMOOTHING_ALPHA=0.2
PACER_LOOKAHEAD_SECONDS=60

# Provider health
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_PROBES=2
