# Local development settings — copy to .env (cp .env.example .env).
# The API, scripts/init_db.py and scripts/seed_demo.py all read this file, so
# they always use the same database.

# ── Database ────────────────────────────────────────────────────────────────
# Option 1 (default): SQLite file in the project directory. No services needed.
# Fine for the demo; row-level locking (FOR UPDATE SKIP LOCKED) is a no-op on
# SQLite, so multi-worker concurrency guarantees are only verified on PostgreSQL.
DATABASE_URL=sqlite:///./smartdialer.db
DATABASE_URL_ASYNC=sqlite+aiosqlite:///./smartdialer.db

# Option 2: PostgreSQL via docker compose (see README), then `alembic upgrade head`.
# DATABASE_URL=postgresql+psycopg://smartdialer:smartdialer_dev@localhost:5432/smartdialer
# DATABASE_URL_ASYNC=postgresql+asyncpg://smartdialer:smartdialer_dev@localhost:5432/smartdialer

TEST_DATABASE_URL=postgresql+psycopg://smartdialer_test:smartdialer_test@localhost:5433/smartdialer_test
TEST_DATABASE_URL_ASYNC=postgresql+asyncpg://smartdialer_test:smartdialer_test@localhost:5433/smartdialer_test

# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key-change-in-prod

# Provider webhook authentication (POST /api/v1/provider-events). JSON object of
# per-provider shared secrets. Empty = unauthenticated webhooks in development
# (a warning is logged); with APP_ENV=production, webhooks are refused until set.
# Sign test requests with scripts/send_provider_event.py.
PROVIDER_WEBHOOK_SECRETS={}
# PROVIDER_WEBHOOK_SECRETS={"mock_provider_a":"change-me-a","mock_provider_b":"change-me-b"}
PROVIDER_WEBHOOK_MAX_SKEW_SECONDS=300

# Dialer defaults
DEFAULT_DIALING_MODE=progressive
MAX_CONCURRENT_CALLS_PER_CAMPAIGN=50
MAX_ATTEMPTS_PER_BORROWER=3
BORROWER_RETRY_COOLDOWN_SECONDS=3600
AGENT_HEARTBEAT_TIMEOUT_SECONDS=30
WORKER_LEASE_SECONDS=60

# Safety controller
SAFETY_MAX_DIAL_RATIO=3.0
SAFETY_STRICT_MODE=true

# Predictive pacing
PACER_UTILIZATION_TARGET=0.85
PACER_SMOOTHING_ALPHA=0.2
PACER_LOOKAHEAD_SECONDS=60

# Provider health
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_PROBES=2

# Background runtime inside the API process (dispatch worker, provider event
# consumers, periodic reconciliation). Reconciliation also releases WRAP_UP agents.
BACKGROUND_WORKERS_ENABLED=true
DISPATCH_POLL_INTERVAL_SECONDS=0.5
RECONCILIATION_INTERVAL_SECONDS=5
DISPATCH_LEASE_SECONDS=30

# Mock providers (the only providers wired in — no real calls are ever placed).
# MOCK_PROVIDER_DELAY_SCALE < 1 makes simulated calls finish faster.
MOCK_PROVIDER_DELAY_SCALE=1.0
# MOCK_PROVIDER_SEED=42
